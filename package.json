{
  "name": "daicho",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && npm test",
    "test": "vitest run && vitest run -c vitest.web.config.ts",
    "test:worker": "vitest run",
    "test:web": "vitest run -c vitest.web.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply daicho --local",
    "db:migrate": "wrangler d1 migrations apply daicho --remote",
    "import-sheet": "tsx scripts/import-sheet.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260926.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "csv-parse": "^5.5.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
